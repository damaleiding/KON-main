# KVA local model/API configuration example.
# Copy this file to `.env` and fill local secrets there.
# Do not commit `.env`.

# OneAgent Claude sub-agent
ONEAGENT_BASE_URL=https://api.gameaigc.cn
ONEAGENT_API_KEY=<your-oneagent-api-key>
ONEAGENT_MODEL=claude-opus-4-7

# Ark DeepSeek sub-agent
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=<your-ark-api-key>
ARK_MODEL_DEEPSEEK=deepseek-v4-pro-260425

# Optional Ark Doubao model used by ai-debate presets.
ARK_MODEL_DOUBAO=<your-doubao-model-id>

# Google AI Studio / Gemini API
# Copy your real key into `.env` only. Never commit real keys.
GOOGLE_API_KEY=<your-google-ai-studio-api-key>
GOOGLE_GEMINI_MODEL=gemini-3.5-flash
